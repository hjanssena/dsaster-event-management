# Puerto y dirección del servidor Axum
SERVER_ADDR=0.0.0.0:3000

# Conexión a la base de datos PostgreSQL
# Para desarrollo local (con event-db corriendo en Docker en puerto 5432):
DATABASE_URL=postgres://usuario:password@localhost:5432/event_store

# Nota: Dentro de Docker Compose, la URL apunta al host "event-db":
# DATABASE_URL=postgres://usuario:password@event-db:5432/event_store
