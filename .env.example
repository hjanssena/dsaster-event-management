# =============================================================================
# Event Management API — Environment Variables
# Copy to .env for local development: cp .env.example .env
# Read exclusively in src/config.rs (see ADR-006, ADR-007, ADR-008).
# =============================================================================

# --- Server & Database (currently read by src/config.rs) ---------------------

# Axum bind address
SERVER_ADDR=0.0.0.0:3000

# PostgreSQL connection string
# Local development (event-db running in Docker on port 5432):
DATABASE_URL=postgres://usuario:password@localhost:5432/event_store
# Inside Docker Compose, point to the "event-db" container host:
# DATABASE_URL=postgres://usuario:password@event-db:5432/event_store

# --- Local Development Mocks & Upstream URLs (currently read) ----------------

# Local dev & tests only. Shared environments (testing, production) MUST set false.
MOCK_AUTH=true

# Use MockVenueClient instead of calling Venue Management Service
MOCK_VENUE_SERVICE=true

# Base URL for Venue Management Service (used when MOCK_VENUE_SERVICE=false)
VENUE_SERVICE_URL=http://localhost:3001

# Bearer JWT forwarded to Venue Management Service when calling GET /venues/{id}
VENUE_SERVICE_TOKEN=

# --- Authentication (ADR-007 — upcoming in src/config.rs) --------------------

# Shared HS256 secret matching Auth Service and Venue Service (required when MOCK_AUTH=false).
# Never commit a real secret.
# JWT_SECRET=change-me-in-shared-environments

# --- Event Propagation, Pagination & Kafka (ADR-006 — upcoming) --------------

# Days before sale_starts_at when a scheduled event becomes public (C6)
EVENT_VISIBILITY_LEAD_DAYS=10

# How often the scheduled publish job checks for events to publish (ADR-003)
EVENT_PUBLISH_JOB_INTERVAL_SECONDS=60

# How often the outbox relay polls unsent rows (ADR-004)
OUTBOX_RELAY_INTERVAL_MS=1000

# Maximum outbox rows processed per relay batch (ADR-004)
OUTBOX_RELAY_BATCH_SIZE=100

# Default and maximum page size for paginated event list endpoints
EVENTS_PAGE_SIZE_DEFAULT=10
EVENTS_PAGE_SIZE_MAX=100

# Kafka bootstrap servers and lifecycle topic (C6)
KAFKA_BROKERS=localhost:9092
KAFKA_EVENTS_TOPIC=events.lifecycle

# --- Resiliency: Timeouts, Retries, Circuit Breaker & Idempotency (ADR-008) --

# Total timeout for one incoming HTTP request
HTTP_REQUEST_TIMEOUT_MS=10000

# Per-attempt timeout calling Venue Service
VENUE_SERVICE_TIMEOUT_MS=2000

# Outgoing retry policy (exponential backoff with full jitter)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=2000

# Circuit breaker per outgoing dependency (Venue Service)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_SECONDS=30

# Kafka producer delivery timeout and outbox relay max failure backoff
KAFKA_MESSAGE_TIMEOUT_MS=30000
OUTBOX_RELAY_MAX_BACKOFF_MS=30000

# PostgreSQL pool acquire timeout and per-statement timeout
DB_POOL_ACQUIRE_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000

# Retention window for POST /api/v1/events Idempotency-Key responses
IDEMPOTENCY_KEY_TTL_HOURS=24
